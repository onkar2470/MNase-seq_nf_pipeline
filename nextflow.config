nextflow.enable.dsl=2

includeConfig 'params.config'

process {
    executor = 'local'
    cpus = params.threads

    // 👇 Enable conda for all processes
    conda = params.conda_env
}

conda {
    enabled = true
    useMamba = true
}

report {
    enabled = true
    file = params.report_file
}

trace {
    enabled = true
    file = params.trace_file
}

timeline {
    enabled = true
    file = params.timeline_file
}

dag {
    enabled = true
    file = params.dag_file
}

